SILICONFLOW_API_KEY=
ARK_API_KEY=
TIKHUB_API_KEY=
PIPI_AUTH_SECRET=
PIPI_DATA_DIR=
PIPI_ALLOWED_ORIGINS=
# 自助注册默认开启；如需暂时关闭，设置为 false。
PIPI_ALLOW_SELF_REGISTRATION=true
PIPI_BOOTSTRAP_ADMIN_ACCOUNT=admin
PIPI_BOOTSTRAP_ADMIN_PASSWORD=
NODE_ENV=production
TIKHUB_BASE_URL=https://api.tikhub.io
TIKHUB_COMPETITOR_SEARCH_ENDPOINT=/api/v1/douyin/search/fetch_general_search_v1
SILICONFLOW_MODEL=Qwen/Qwen3-8B
SILICONFLOW_FALLBACK_MODELS=zai-org/GLM-5.2,deepseek-ai/DeepSeek-V4-Flash
ARK_PLAN_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
# 火山云账单余额：使用有 Billing 只读权限的 IAM AK/SK，不要使用 Ark 模型 API Key。
VOLC_BILLING_ACCESS_KEY_ID=
VOLC_BILLING_SECRET_ACCESS_KEY=
VOLC_BILLING_ENDPOINT=https://open.volcengineapi.com
VOLC_BILLING_REGION=cn-beijing
VOLC_BILLING_SERVICE=billing
VOLC_BILLING_ACTION=QueryBalanceAcct
VOLC_BILLING_VERSION=2022-01-01
PIPI_API_PORT=8787
